{
  "name": "meridian-vault-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "Vault ERC-4626 multiestrategia para stablecoins",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "clean": "forge clean",
    "test": "forge test",
    "test:verbose": "forge test -vvv",
    "coverage": "forge coverage",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "snapshot": "forge snapshot",
    "ci": "node scripts/run-ci.mjs",
    "fmt:docs": "prettier --write --config .prettierrc --ignore-path .prettierignore \"**/*.md\" \".github/**/*.yml\" \"scripts/**/*.mjs\" \"*.json\"",
    "fmt:docs:check": "prettier --check --config .prettierrc --ignore-path .prettierignore \"**/*.md\" \".github/**/*.yml\" \"scripts/**/*.mjs\" \"*.json\"",
    "loc": "node scripts/check-loc.mjs",
    "scan:public": "node scripts/scan-public.mjs",
    "release:check": "node scripts/release-integrity.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
